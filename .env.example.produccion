# Variables del servidor (Railway). Ninguna lleva valores reales aquí.

# --- Base de datos (Supabase, conexión por el pooler) ---
DATABASE_URL=postgresql+psycopg://postgres.REFERENCIA:CONTRASENA@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# --- Seguridad ---
SECRET_KEY=generar-con-openssl-rand-hex-32
ENVIRONMENT=production
DEBUG=false

# --- Dominios permitidos (CORS y Host) ---
CORS_ORIGINS=https://parotasgolf.com,https://www.parotasgolf.com

# --- Operación ---
TIMEZONE=America/Mexico_City
RESPETAR_HORARIOS=true
QR_BASE_URL=https://parotasgolf.com/pase

# --- Arranque: migra solo y siembra la primera vez ---
MIGRAR_AL_ARRANCAR=true
SEED_ADMIN_EMAIL=reservas@parotasgolf.com
SEED_ADMIN_PASSWORD=la-que-elija-el-club

# --- Correo (por HTTPS, no por SMTP) ---
# Railway bloquea los puertos de SMTP en sus planes chicos, asi que el envio
# sale por la API de Resend. El buzon sigue siendo el de Google Workspace.
RESEND_API_KEY=re-la-llave-que-da-resend
MAIL_FROM=reservas@parotasgolf.com
MAIL_FROM_NAME=Las Parotas Club de Golf

# Alternativa, solo si algun dia corre en un servidor que si permita SMTP.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=reservas@parotasgolf.com
# SMTP_PASSWORD=contrasena-de-aplicacion
# SMTP_FROM=reservas@parotasgolf.com

# ------------------------------------------------ sitio público del club
# El sitio y el sistema los sirve el mismo contenedor, bajo el mismo dominio,
# así que no hay peticiones entre orígenes distintos. Esta lista solo necesita
# el dominio propio, para que el servidor se reconozca a sí mismo.
CORS_ORIGINS=https://parotasgolf.com,https://www.parotasgolf.com

# ------------------------------------------------------------- cobro Stripe
# Mientras se prueba, las llaves de test (sk_test_…). Al salir en serio se
# cambian por las de producción (sk_live_…) y se da de alta el webhook otra
# vez, porque su firma es distinta.
STRIPE_SECRET_KEY=sk_test_...
# De https://dashboard.stripe.com/webhooks, al dar de alta el destino
# https://parotasgolf.com/api/public/stripe/webhook con el evento
# checkout.session.completed
STRIPE_WEBHOOK_SECRET=whsec_...
SITIO_URL=https://parotasgolf.com

# El simulador de tarjetas NO se prende en producción. Stripe le gana de todos
# modos, pero dejarlo apagado evita cualquier duda.
PAGOS_SIMULADOS=false
APARTADO_MINUTOS=30
