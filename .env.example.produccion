# Variables del servidor (Railway). Ninguna lleva valores reales aquí.

# --- Base de datos (Supabase, conexión por el pooler) ---
DATABASE_URL=postgresql+psycopg://postgres.REFERENCIA:CONTRASENA@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# --- Seguridad ---
SECRET_KEY=generar-con-openssl-rand-hex-32
ENVIRONMENT=production
DEBUG=false

# --- Dominios permitidos (CORS y Host) ---
CORS_ORIGINS=https://parotasgolf.com,https://www.parotasgolf.com

# --- Operación ---
TIMEZONE=America/Mexico_City
RESPETAR_HORARIOS=true
QR_BASE_URL=https://parotasgolf.com/pase

# --- Arranque: migra solo y siembra la primera vez ---
MIGRAR_AL_ARRANCAR=true
SEED_ADMIN_EMAIL=reservas@parotasgolf.com
SEED_ADMIN_PASSWORD=la-que-elija-el-club

# --- Correo (cuando se conecte el envío de pases) ---
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=reservas@parotasgolf.com
# SMTP_PASSWORD=contrasena-de-aplicacion-de-google
# SMTP_FROM=reservas@parotasgolf.com
