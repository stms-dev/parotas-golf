VITE_API_URL=/api

# Opcional. Si se deja vacío, el socket usa el mismo host que la página
# (a través del proxy de Vite en desarrollo, o del proxy inverso en producción).
# Solo se llena si el backend vive en otro dominio.
# VITE_WS_URL=wss://api.midominio.com/api/ws

# --------------------------------------------------------------------- túnel
# Dominio público por el que se entra al sistema (ngrok, Cloudflare Tunnel…).
# Solo se llena cuando se va a exponer hacia afuera; en local se deja vacío.
# Con o sin https:// da lo mismo.
# VITE_PUBLIC_HOST=las-parotas.ngrok.app

# A dónde reenvía Vite las peticiones /api. Por omisión, el backend local.
# VITE_BACKEND_ORIGIN=http://localhost:8000

# El sitio público del club, para la liga de regreso en el login.
# El sitio del club. Al compartir dominio con el sistema basta la raíz.
VITE_SITIO_PUBLICO=/
