# Copiar como .env y ajustar

APP_NAME="Las Parotas API"
ENVIRONMENT=development
DEBUG=true
API_PREFIX=/api

# Local: SQLite. Despliegue: cambiar a PostgreSQL y no se toca nada más.
DATABASE_URL=sqlite:///./las_parotas.db
# DATABASE_URL=postgresql+psycopg://usuario:clave@host:5432/las_parotas

# Generar con: openssl rand -hex 32
SECRET_KEY=CAMBIAR-ESTA-LLAVE-EN-PRODUCCION
ACCESS_TOKEN_EXPIRE_MINUTES=480

# El navegador solo habla con el dominio del front, y ese dominio reenvía
# /api desde el servidor, así que en un túnel normalmente basta con el local.
# Si algún día el backend se publica en su propio dominio, se agrega aquí.
CORS_ORIGINS=["http://localhost:5173"]
# CORS_ORIGINS=["http://localhost:5173","https://las-parotas.ngrok.app"]

# Bloqueo de horarios. En false (lo normal) no se vende una salida que ya
# pasó, ni se reserva para hoy después de la hora límite del día, que se
# cambia desde Control del sistema (15:00 de fábrica).
# Solo para ensayar el check-in a cualquier hora se pone en true; nunca en
# operación real.
# true = funcionamiento real (no se reservan horarios que ya pasaron)
# false = modo pruebas (se puede elegir un horario aunque ya haya pasado)
RESPETAR_HORARIOS=true

SLOT_CAPACITY=4
CASH_CUTOFF_HOUR=22
TIMEZONE=America/Mexico_City

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@lasparotas.mx

# Los QR de los correos viajan fuera del equipo: esta dirección tiene que ser
# la pública, o el huésped abrirá un enlace a su propia computadora.
QR_BASE_URL=http://localhost:5173/pase
# QR_BASE_URL=https://las-parotas.ngrok.app/pase

# ------------------------------------------------- reserva desde el sitio
# Las dos llaves de Stripe. Con la secreta puesta, el sitio cobra de verdad;
# sin ella, aparta la salida y avisa que el club va a llamar.
#   sk_test_… para probar · sk_live_… cuando sea en serio
STRIPE_SECRET_KEY=
# La firma con la que Stripe avisa que un pago entró. SIN ESTO NO SE CONFIRMA
# NADA: sin verificarla, cualquiera podría avisar que pagó mandando un JSON.
# Sale del panel de Stripe al dar de alta el webhook, o del `stripe listen`.
STRIPE_WEBHOOK_SECRET=
# A dónde vuelve el huésped desde Stripe.
SITIO_URL=http://localhost:5180

# El simulador de tarjetas, para desarrollar sin tocar Stripe. Stripe le gana
# si las dos están puestas.
PAGOS_SIMULADOS=false
# Cuánto se le aparta la salida a quien está pagando. Treinta es el mínimo que
# Stripe permite para que su sesión de pago venza, y conviene que las dos
# caduquen juntas.
APARTADO_MINUTOS=30
